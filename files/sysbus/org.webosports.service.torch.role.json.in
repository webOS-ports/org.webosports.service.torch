{
    "exeName": "@WEBOS_INSTALL_SBINDIR@/torchd",
    "trustLevel": "oem",
    "type": "regular",
    "allowedNames": ["org.webosports.service.torch", ""],
    "permissions": [
        {
            "service": "org.webosports.service.torch",
            "inbound": ["*"],
            "outbound": ["*"]
        }
    ]
}
